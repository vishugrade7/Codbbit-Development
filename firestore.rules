/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and allows public read access to coding questions and problem sheets.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles.  Access is restricted to the owning user.
 * - /questions/{questionId}: Stores coding questions. Publicly readable.
 * - /sheets/{sheetId}: Stores problem sheets. Publicly readable.
 * - /vouchers/{voucherId}: Stores voucher information.  No specific access rules defined, defaulting to none.
 * - /config/{configId}: Stores configuration settings. No specific access rules defined, defaulting to none.
 * - /packages/URL/packages/{packageName}: Stores managed package information. No specific access rules defined, defaulting to none.
 *
 * Key Security Decisions:
 * - User profiles are strictly owned by the authenticated user.
 * - Coding questions and problem sheets are publicly readable to facilitate open access to learning resources.
 * - Listing of user documents is forbidden.
 * - Vouchers, Configuration, and Managed Package information are not accessible by default.
 *
 * Denormalization for Authorization:
 *   - User profiles are stored under /users/{userId}, which matches the Firebase Auth UID, enabling simple `isOwner()` checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) Authenticated user can create their own profile.
     * @deny (create) Authenticated user cannot create a profile for another user.
     * @allow (get, list) Authenticated user can read their own profile.
     * @deny (get, list) Authenticated user cannot read another user's profile.
     * @allow (update, delete) Authenticated user can update or delete their own profile.
     * @deny (update, delete) Authenticated user cannot update or delete another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to code question documents.
     * @path /questions/{questionId}
     * @allow (get, list) Any user can read coding questions.
     * @deny (create, update, delete) No user can create, update, or delete coding questions.
     * @principle Allows public read access, restricts write access.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to problem sheet documents.
     * @path /sheets/{sheetId}
     * @allow (get, list) Any user can read problem sheets.
     * @deny (create, update, delete) No user can create, update, or delete problem sheets.
     * @principle Allows public read access, restricts write access.
     */
    match /sheets/{sheetId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to voucher documents.
     * @path /vouchers/{voucherId}
     * @deny (get, list, create, update, delete) No user can access voucher information by default.
     * @principle Restricts all access to vouchers by default.
     */
    match /vouchers/{voucherId} {
      allow read, write: if false;
    }

     /**
      * @description Controls access to config documents.
      * @path /config/{configId}
      * @deny (get, list, create, update, delete) No user can access config information by default.
      * @principle Restricts all access to configuration by default.
      */
    match /config/{configId} {
      allow read, write: if false;
    }

     /**
      * @description Controls access to managed package documents.
      * @path /packages/URL/packages/{packageName}
      * @deny (get, list, create, update, delete) No user can access package information by default.
      * @principle Restricts all access to managed packages by default.
      */
    match /packages/{url}/packages/{packageName} {
        allow read, write: if false;
    }
  }
}