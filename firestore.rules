/**
 * @fileoverview Firestore Security Rules for Codbbit application.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure user data access. User profiles are strictly controlled by their respective owners.
 * Public access is granted to coding questions and problem sheets. Vouchers and packages are read-only to authenticated users.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the user themselves.
 * - /questions/{questionId}: Publicly accessible coding questions.
 * - /sheets/{sheetId}: Publicly accessible problem sheets.
 * - /vouchers/{voucherId}: Vouchers, publicly readable.
 * - /config/{configId}: Application configuration, publicly readable.
 * - /packages/{packageName}: Managed packages, publicly readable.
 *
 * Key Security Decisions:
 * - User listing is explicitly denied.
 * - Data consistency is enforced between the path and the document's internal `uid` field in `/users/{userId}`.
 * - Public read access is granted to questions and sheets.
 * - Write operations are only allowed with validated ownership.
 *
 * Denormalization for Authorization:
 *  N/A - No denormalization is used in this ruleset.
 *
 * Structural Segregation:
 *  N/A - No structural segregation is used in this ruleset.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles under /users/{userId}.
     * @path /users/{userId}
     * @allow (create) - Authenticated user creates their profile with matching UID.
     * @allow (get, update, delete) - Authenticated user accesses their own profile.
     * @deny (create) - Authenticated user tries to create a profile with a mismatched UID.
     * @deny (get, update, delete) - Authenticated user tries to access another user's profile.
     * @deny (list) - Listing users is not permitted.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Only the owner can read their profile.
      allow get: if isOwner(userId);

      // Only the owner can list their own profile (should be empty)
      allow list: if false; // Listing is never allowed for security

      // Only the user can create their own profile, and the uid must match.
      allow create: if isSignedIn() && request.auth.uid == userId;

      // Only the owner can update their own profile.
      allow update: if isExistingOwner(userId);

      // Only the owner can delete their own profile.
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allow public read access to coding questions. Owner-only writes are disallowed until an ownership field is added.
     * @path /questions/{questionId}
     * @allow (get, list) - Any user can read the questions.
     * @deny (create, update, delete) - No one can write.
     * @principle Allows public read access to coding questions; write operations are disabled until owner validation is added.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allow public read access to problem sheets. Owner-only writes are disallowed until an ownership field is added.
     * @path /sheets/{sheetId}
     * @allow (get, list) - Any user can read the sheets.
     * @deny (create, update, delete) - No one can write.
     * @principle Allows public read access to problem sheets; write operations are disabled until owner validation is added.
     */
    match /sheets/{sheetId} {
      allow get, list: if true;
       allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allow public read access to vouchers. Owner-only writes are disallowed until an ownership field is added.
     * @path /vouchers/{voucherId}
     * @allow (get, list) - Any user can read the vouchers.
     * @deny (create, update, delete) - No one can write.
     * @principle Allows public read access to vouchers; write operations are disabled until owner validation is added.
     */
    match /vouchers/{voucherId} {
      allow get, list: if true;
       allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allow public read access to config. Owner-only writes are disallowed until an ownership field is added.
     * @path /config/{configId}
     * @allow (get, list) - Any user can read the config.
     * @deny (create, update, delete) - No one can write.
     * @principle Allows public read access to config; write operations are disabled until owner validation is added.
     */
    match /config/{configId} {
      allow get, list: if true;
       allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allow public read access to packages. Owner-only writes are disallowed until an ownership field is added.
     * @path /packages/{packageName}
     * @allow (get, list) - Any user can read the packages.
     * @deny (create, update, delete) - No one can write.
     * @principle Allows public read access to packages; write operations are disabled until owner validation is added.
     */
    match /packages/{packageName} {
      allow get, list: if true;
       allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}